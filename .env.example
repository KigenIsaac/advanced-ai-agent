# Required for normal agent operation
AGNES_API_KEY=

# Optional provider/model configuration
AGNES_PROVIDER=agnes
AGNES_MODEL=agnes-3.0-flash
AGNES_BASE_URL=

# Optional runtime settings
AGNES_HOME=
AGNES_PROJECT=
AGNES_MAX_RETRIES=5
AGNES_MAX_ROUNDS=
AGNES_TEMPERATURE=0.3

# Choose a provider: deepseek, qwen, kimi, local, ollama, etc.
# AGNES_PROVIDER=deepseek
# AGNES_MODEL=deepseek-flash
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# MOONSHOT_API_KEY=

# Qwen: use your own region/workspace-specific Model Studio endpoint.
# QWEN_BASE_URL=https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Safeguard for multi-step agents: cap paid model rounds.
# AGNES_MAX_ROUNDS=20
